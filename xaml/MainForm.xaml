
    <Grid Margin="0,0,0,0" Background="White" ShowGridLines="false">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />             
            <RowDefinition Height="*" />             
			<RowDefinition Height="Auto" />  			
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/> 
            <ColumnDefinition Width="*"/>					
        </Grid.ColumnDefinitions>
			
		
			<Ribbon Name="ribMapiPermission"  Grid.Row="0" Grid.RowSpan="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,10,10,0" SelectedIndex="0" >
				<Ribbon.Background>
					<ImageBrush/>
				</Ribbon.Background>
				
		<!-- TAB START--> 			
				<RibbonTab Header="Start" KeyTip="H" >
				
					<RibbonGroup Name="rtabClose"  Header="Close">
						<RibbonButton Name="rbtnClose" Label="Close" />
					</RibbonGroup>
					
					<RibbonGroup Name="rtabStart" Header="Search">
						<RibbonButton Name="rbtnSearch" Label="Search" />					
					</RibbonGroup>
						
					<RibbonGroup Name="rtabExport" Header="CSV-Export">
						<RibbonButton Name="rbtnCsvExport" Label="Export" />					
					</RibbonGroup>
					
					<RibbonGroup Name="rtabFilter" Header="Filter">
						<RibbonButton Name="rbtnClearFilter" Label="Clear" />					
					</RibbonGroup>
				</RibbonTab>
			</Ribbon>
			
			<Expander  Name="expInfo" Grid.Row="1" Grid.RowSpan="2" Grid.Column="0"  Grid.ColumnSpan="1" Margin="0,10,0,10" ExpandDirection="Right" VerticalAlignment="Stretch" >
				<Grid>
					<Grid.RowDefinitions>					
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*" />	
					</Grid.RowDefinitions>
					
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />					                       
					</Grid.ColumnDefinitions>
				
					<GroupBox Name="groupboxExchangeServer" Grid.Row="0" Grid.Column="0" Margin="10,10,0,0" >
						<GroupBox.Header>Exchange Server (0)</GroupBox.Header>
						<Grid>
							<Grid.RowDefinitions>
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />                   
							</Grid.RowDefinitions>

							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />                   
							</Grid.ColumnDefinitions>

							<ListBox  Name="lstExchangeServer" Grid.Row="0" Grid.Column="0" Margin="5,10,5,0" />
							<CheckBox Name="chkSelectAll"      Grid.Row="1" Grid.Column="0" Margin="10,10,0,0" Content="Select all" />
						   
						</Grid>
					</GroupBox>
										
					<TreeView Name="treMessageTracking" Grid.Row="1" Grid.Column="0" Margin="10,10,0,0" VerticalAlignment="Stretch" />
					
				</Grid>	
			</Expander>
		
			
        <GroupBox Name="groupboxFilter" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,20,10,0" >
            <GroupBox.Header>F I L T E R</GroupBox.Header>
            <Grid ShowGridLines="false">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CheckBox   Name="chkTimeStart" Grid.Row="0" Grid.Column="0" Margin="10,10,0,0"  Content="Start" />
                <DatePicker Name="dpStart"      Grid.Row="0" Grid.Column="1" Margin="0,10,10,0" />
                <TextBox    Name="txtStartHour" Grid.Row="0" Grid.Column="2" Margin="0,10,0,0"   Width="25" Text="0"    HorizontalAlignment="Left" 
							VerticalAlignment="Top" Background="Cornsilk" />
					
                <Label      Name="lblStartDot"  Grid.Row="0" Grid.Column="2" Margin="30,5,30,0"  Width="20" Content=":" HorizontalAlignment="Left" />
                <TextBox    Name="txtStartMin"  Grid.Row="0" Grid.Column="2" Margin="50,10,10,0" Width="25" Text="0"    HorizontalAlignment="Left" 
							VerticalAlignment="Top" Background="Cornsilk" />
                
                <CheckBox   Name="chkTimeEnd" Grid.Row="1" Grid.Column="0" Margin="10,10,0,0"  Content="End"  />
                <DatePicker Name="dpEnd"      Grid.Row="1" Grid.Column="1" Margin="0,10,10,0"  />
                <TextBox    Name="txtEndHour" Grid.Row="1" Grid.Column="2" Margin="0,10,0,0"   Width="25" Text="0"    HorizontalAlignment="Left" VerticalAlignment="Top"  Background="Cornsilk" />
                <Label      Name="lblEndDot"  Grid.Row="1" Grid.Column="2" Margin="30,5,30,0"  Width="20" Content=":" HorizontalAlignment="Left" />
                <TextBox    Name="txtEndMin"  Grid.Row="1" Grid.Column="2" Margin="50,10,10,0" Width="25" Text="0"    HorizontalAlignment="Left" VerticalAlignment="Top"  Background="Cornsilk" />

                <Label      Name="lblSender"  Grid.Row="2" Grid.Column="0"  Margin="5,10,0,0" Content="Sender" />
                <TextBox    Name="txtSender"  Grid.Row="2" Grid.Column="1"  Margin="0,10,10,0" />
                <ComboBox   Name="cboSender"  Grid.Row="2" Grid.Column="2"  Margin="0,10,10,0" />

                <Label    Name="lblRecipient" Grid.Row="3" Grid.Column="0" Margin="5,10,0,0" Content="Recipient" />
                <TextBox  Name="txtRecipient" Grid.Row="3" Grid.Column="1" Margin="0,10,10,0" />
                <ComboBox Name="cboRecipient" Grid.Row="3" Grid.Column="2" Margin="0,10,10,0" />

                <Label    Name="lblSubject" Grid.Row="4" Grid.Column="0" Margin="5,10,0,0" Content="Subject" />
                <TextBox  Name="txtSubject" Grid.Row="4" Grid.Column="1" Margin="0,10,10,0"  />
				<ComboBox Name="cboSubject" Grid.Row="4" Grid.Column="2" Margin="0,10,10,0" />

                <Label    Name="lblEventID"  Grid.Row="5" Grid.Column="0" Margin="5,10,0,0"  Content="Event-ID" />
				<ComboBox Name="cboEventID"  Grid.Row="5" Grid.Column="1" Margin="0,10,10,0" Width="auto" HorizontalAlignment="Stretch" />
				<ComboBox Name="cboEventID2" Grid.Row="5" Grid.Column="2" Margin="0,10,10,0" />

                <Label    Name="lblMessageID" Grid.Row="6" Grid.Column="0" Margin="5,10,0,0" Content="Message-ID" />
                <TextBox  Name="txtMessageID" Grid.Row="6" Grid.Column="1" Margin="0,10,10,0" />
				<ComboBox Name="cboMessageID" Grid.Row="6" Grid.Column="2" Margin="0,10,10,0" />


                <Label    Name="lblSource" Grid.Row="0" Grid.Column="3" Margin="0,10,0,0" Content="Source" />
                <TextBox  Name="txtSource" Grid.Row="0" Grid.Column="4" Margin="0,10,10,0" />
				<ComboBox Name="cboSource" Grid.Row="0" Grid.Column="5" Margin="0,10,10,0" />

                <Label    Name="lblClientHostname" Grid.Row="1" Grid.Column="3" Margin="0,10,0,0" Content="ClientHostname" />
                <TextBox  Name="txtClientHostname" Grid.Row="1" Grid.Column="4" Margin="0,10,10,0" />
				<ComboBox Name="cboClientHostname" Grid.Row="1" Grid.Column="5" Margin="0,10,10,0" />

                <Label    Name="lblServerHostname" Grid.Row="2" Grid.Column="3" Margin="0,10,0,0" Content="ServerHostname" />
                <TextBox  Name="txtServerHostname" Grid.Row="2" Grid.Column="4" Margin="0,10,10,0" />
				<ComboBox Name="cboServerHostname" Grid.Row="2" Grid.Column="5" Margin="0,10,10,0" />

                <Label    Name="lblSourceContext" Grid.Row="3" Grid.Column="3" Margin="0,10,0,0" Content="SourceContext" />
                <TextBox  Name="txtSourceContext" Grid.Row="3" Grid.Column="4" Margin="0,10,10,0" />
				<ComboBox Name="cboSourceContext" Grid.Row="3" Grid.Column="5" Margin="0,10,10,0" />

                <Label    Name="lblConnectorId" Grid.Row="4" Grid.Column="3" Margin="0,10,0,0" Content="ConnectorId" />
                <TextBox  Name="txtConnectorId" Grid.Row="4" Grid.Column="4" Margin="0,10,10,0" />
				<ComboBox Name="cboConnectorId" Grid.Row="4" Grid.Column="5" Margin="0,10,10,0" />

                <Label    Name="lblRecipientStatus" Grid.Row="5" Grid.Column="3" Margin="0,10,0,0" Content="RecipientStatus" />
                <TextBox  Name="txtRecipientStatus" Grid.Row="5" Grid.Column="4" Margin="0,10,10,0" />
				<ComboBox Name="cboRecipientStatus" Grid.Row="5"  Grid.Column="5" Margin="0,10,10,0" />

				<Label    Name="lblIntMessageID" Grid.Row="6" Grid.Column="3" Margin="5,10,0,0"  Content="Int. Message-ID" />
                <TextBox  Name="txtIntMessageID" Grid.Row="6" Grid.Column="4" Margin="0,10,10,0" Text="" />
				<ComboBox Name="cboIntMessageID" Grid.Row="6" Grid.Column="5" Margin="0,10,10,0" />
            </Grid>
        </GroupBox>

        <DataGrid Name="dgMessageTracking" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" Margin="10,10,10,10" >
			
		</DataGrid>
		
        <StatusBar Name="staInfo" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="10,0,10,10" Height="50" HorizontalAlignment="Stretch" VerticalAlignment="Top" >
			<Grid>
				<Grid.RowDefinitions>					
					<RowDefinition Height="Auto" />									
				</Grid.RowDefinitions>
				
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />					                       
				</Grid.ColumnDefinitions>			
               
				<StatusBarItem Grid.Row="0" Grid.Column="0" >
					<TextBox Name="txtStatusInfo" FontSize="18" Background="Transparent" BorderThickness="0" />
				</StatusBarItem>
				
			</Grid>
        </StatusBar>	
    
	</Grid>       
    
